; Engine configuration file.
config_version=5

[application]

config/name="Cold Glitter Creek"
config/description="A cozy vintage American folk-tale papercraft game (port of the three.js version)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/vram_compression/import_etc2_astc=false

[shader_globals]

paper_fiber={
"type": "sampler2D",
"value": "res://assets/baked/paper/fiber.png"
}
paper_wash={
"type": "sampler2D",
"value": "res://assets/baked/paper/wash.png"
}
paper_handmade={
"type": "sampler2D",
"value": "res://assets/baked/paper/handmade.png"
}
paper_noise={
"type": "sampler2D",
"value": "res://assets/baked/paper/noise.png"
}
paper_ground_reach={
"type": "vec4",
"value": Vector4(0, 0, 100000, 0)
}
paper_key_dir={
"type": "vec3",
"value": Vector3(-0.5, 0.7, 0.5)
}
paper_snow={
"type": "float",
"value": 0.0
}
paper_ice={
"type": "float",
"value": 0.0
}
paper_cloud_shade={
"type": "float",
"value": 0.0
}
paper_focus={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
paper_haze={
"type": "vec3",
"value": Vector3(0.69, 0.52, 0.27)
}
paper_horizon={
"type": "vec3",
"value": Vector3(0.89, 0.71, 0.48)
}
paper_haze_amt={
"type": "float",
"value": 0.3
}
paper_glow={
"type": "float",
"value": 0.0
}
